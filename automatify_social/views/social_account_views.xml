<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_automatify_social_account_list" model="ir.ui.view">
        <field name="name">automatify.social.account.list</field>
        <field name="model">automatify.social.account</field>
        <field name="arch" type="xml">
            <list string="Social Accounts">
                <field name="name"/>
                <field name="platform"/>
                <field name="handle"/>
                <field name="connection_state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_automatify_social_account_form" model="ir.ui.view">
        <field name="name">automatify.social.account.form</field>
        <field name="model">automatify.social.account</field>
        <field name="arch" type="xml">
            <form string="Social Account">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="platform"/>
                            <field name="handle"/>
                            <field name="external_account_id"/>
                        </group>
                        <group>
                            <field name="connection_state" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="last_sync_at" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="not last_error">
                        <field name="last_error" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_automatify_social_accounts" model="ir.actions.act_window">
        <field name="name">Social Accounts</field>
        <field name="res_model">automatify.social.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
