<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_automatify_social_user" model="res.groups">
        <field name="name">Social Marketing User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_automatify_social_manager" model="res.groups">
        <field name="name">Social Marketing Manager</field>
        <field name="implied_ids" eval="[(4, ref('automatify_social.group_automatify_social_user'))]"/>
    </record>

    <record id="social_account_company_rule" model="ir.rule">
        <field name="name">Social accounts: allowed companies</field>
        <field name="model_id" ref="model_automatify_social_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('automatify_social.group_automatify_social_user'))]"/>
    </record>

    <record id="social_post_company_rule" model="ir.rule">
        <field name="name">Social posts: allowed companies</field>
        <field name="model_id" ref="model_automatify_social_post"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('automatify_social.group_automatify_social_user'))]"/>
    </record>

    <record id="social_post_target_company_rule" model="ir.rule">
        <field name="name">Social post targets: allowed companies</field>
        <field name="model_id" ref="model_automatify_social_post_target"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('automatify_social.group_automatify_social_user'))]"/>
    </record>
</odoo>
