<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_markdown_import_wizard_form" model="ir.ui.view">
        <field name="name">automatify.social.markdown.import.wizard.form</field>
        <field name="model">automatify.social.markdown.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Markdown">
                <group>
                    <field name="post_id" invisible="not post_id" readonly="1"/>
                    <field
                        name="markdown_file"
                        filename="filename"
                        options="{'accepted_file_extensions': '.md,.markdown'}"
                    />
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_social_markdown_import_new" model="ir.actions.act_window">
        <field name="name">New from Markdown</field>
        <field name="res_model">automatify.social.markdown.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_social_markdown_import_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
